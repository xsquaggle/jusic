{
  "name": "jusic",
  "version": "1.0.0",
  "private": true,
  "description": "A local music player for your own files.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "app": "node server.js --app",
    "rescan": "node server.js --no-open",
    "icons": "node tools/make-icons.js",
    "shortcut": "powershell -ExecutionPolicy Bypass -File tools/install-shortcut.ps1",
    "unshortcut": "powershell -ExecutionPolicy Bypass -File tools/install-shortcut.ps1 -Uninstall"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "45.3.2"
  }
}
